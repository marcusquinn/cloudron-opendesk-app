+// oidcSignup reports whether a new account may come from the instance's own OIDC
+// provider while public signup is off (OIDC_SIGNUP_ENABLED=true): that provider,
+// such as a Cloudron server's user directory, decides who may sign in.
+func oidcSignup(provider string) bool {
+	on, _ := strconv.ParseBool(os.Getenv("OIDC_SIGNUP_ENABLED"))
+	return on && provider == "oidc"
+}
