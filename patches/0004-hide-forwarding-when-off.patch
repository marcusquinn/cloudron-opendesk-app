-  const out: Way[] = [{ id: "forwarding" }];
+  const out: Way[] = forwardingOn(opts) ? [{ id: "forwarding" }] : [];
   if (!imapOn(opts)) return out;
   if (oauthOffered(opts, "google")) out.push({ id: "google" });
