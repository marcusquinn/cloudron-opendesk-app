+/**
+ * Offer forwarding when an inbound route exists, or as the last receiving option
+ * when neither IMAP nor a direct provider API is available.
+ */
+export function forwardingOn(opts?: MailboxConnectOptions): boolean {
+  return opts?.forwarding?.enabled !== false || (!imapOn(opts) && !apiOn(opts, "google") && !apiOn(opts, "microsoft"));
+}
+
 /** Sending through opendesk is offered unless the API has it off. */
