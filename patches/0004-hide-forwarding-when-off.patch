+/**
+ * Receiving by forwarding is offered when the instance receives forwarded mail
+ * (INBOUND_SECRET or INBOUND_SMTP_ADDR), and always where IMAP is off, since it is
+ * then the only way in.
+ */
+export function forwardingOn(opts?: MailboxConnectOptions): boolean {
+  return opts?.forwarding?.enabled !== false || !imapOn(opts);
+}
