# opendesk settings for this Cloudron app. KEY=value per line; restart the app
# after editing. Values are literal (never evaluated by a shell).
#
# The package manages database, URLs, secrets, Cloudron SSO and the embedded
# NATS; those keys are ignored here. Reference for everything else:
# https://docs.opendesk.sh/self-hosting/

# Accounts. With SIGNUP_ENABLED=false nobody can register with a password, and
# Cloudron users (allowed by the app's access control) sign in with Cloudron.
# SIGNUP_ENABLED=false
# OIDC_SIGNUP_ENABLED=true
# OIDC_NAME=Cloudron

# Platform email (sign-in links, invitations, notifications). Defaults to the
# Cloudron mail relay; set these to use another SMTP server instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
# MAIL_FROM=Support <support@example.com>

# Mailboxes: receive over IMAP, and let mailboxes without their own SMTP send
# through the platform relay.
# MAILBOX_IMAP=true
# MAILBOX_SYSTEM_SEND=true

# AI features (optional): one provider key turns them on. Guide, including
# LM Studio over NetBird and NanoGPT: see "AI" in the package README.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
#
# Any OpenAI-compatible API (OpenAI, LM Studio, NanoGPT, Ollama, vLLM):
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://nano-gpt.com/api/v1
# OPENAI_API_KEY=
# AI_MODEL=
# AI_FAST_MODEL=
# Semantic search uses the same endpoint: name an embedding model it serves,
# or set EMBEDDINGS_DRIVER=none for full-text search.
# EMBEDDINGS_MODEL=
# EMBEDDINGS_DRIVER=none

# Attachments: local disk under /app/data/files by default (backed up), or S3.
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
